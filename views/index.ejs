
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mini WhatsApp - All Chats</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <div class="container">

        <header class="header">
            <div>
                <h1>Mini WhatsApp</h1>
                <p>Your personal chat manager</p>
            </div>

            <a href="/chats/new" class="new-chat-btn">
                + New Chat
            </a>
        </header>

        <div class="chat-heading">
            <h2>All Chats</h2>
            <span><%= chats.length %> Conversations</span>
        </div>

        <div class="chat-list">

            <% for(let chat of chats) { %>

                <div class="chat-card">

                    <div class="chat-top">

                        <div class="chat-avatar">
                            <%= chat.from.charAt(0).toUpperCase() %>
                        </div>

                        <div class="chat-info">
                            <h3><%= chat.from %></h3>
                            <p>To: <%= chat.to %></p>
                        </div>

                        <div class="chat-date">
                            <span>
                                <%= chat.created_at.toString().split(" ")[4] %>
                            </span>
                            <small>
                                <%= chat.created_at.toString().split(" ").slice(0, 4).join(" ") %>
                            </small>
                        </div>

                    </div>

                    <div class="message">
                        <p><%= chat.message %></p>
                    </div>

                    <div class="chat-actions">

                        <a href="/chats/<%= chat._id %>"
                           class="show-btn">View</a>

                        <a href="/chats/<%= chat._id %>/edit"
                           class="edit-btn">Edit</a>

                        <form action="/chats/<%= chat._id %>/delete"
                              method="POST"
                              onsubmit="return confirm('Are you sure you want to delete this chat?')">

                            <button type="submit" class="delete-btn">
                                Delete
                            </button>

                        </form>

                    </div>

                </div>

            <% } %>

            <% if(chats.length === 0) { %>

                <div class="empty-chat">
                    <h3>No chats yet!</h3>
                    <p>Start a new conversation by clicking New Chat.</p>
                </div>

            <% } %>

        </div>

    </div>

</body>
</html>
